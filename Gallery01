        .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    padding: 0 0 110px;
}

.gallery-card {
    position: relative;
    height: 520px;
    overflow: hidden;
    cursor: pointer;
    background: #151716;
}

.gallery-card--wide {
    grid-row: span 1;
}

.gallery-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.86);
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.8s ease;
}

.gallery-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.95), rgba(0, 0, 0, 0.35) 48%, rgba(0, 0, 0, 0.05));
    content: "";
}

.gallery-card::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(200, 167, 106, 0.08);
    content: "";
    opacity: 0;
    transition: opacity 0.5s ease;
}

.gallery-card:hover img {
    filter: saturate(1.05);
    transform: scale(1.08);
}

.gallery-card:hover::before {
    opacity: 1;
}

.card-overlay {
    position: absolute;
    right: 24px;
    bottom: 20px;
    left: 24px;
    z-index: 2;
}

.card-number {
    display: block;
    margin-bottom: 5px;
    color: var(--gold);
    font-family: var(--serif);
    font-size: 17px;
}

.card-overlay h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 14px;
    font-family: var(--serif);
    font-size: 25px;
    font-weight: 400;
    text-transform: uppercase;
}

.card-overlay h2 span {
    padding-left: 9px;
    color: var(--gold);
    font-family: "DM Sans", sans-serif;
    font-size: 18px;
    font-weight: 300;
}

.card-overlay p {
    margin-top: 12px;
    color: #c0bbb1;
    font-size: 10px;
    line-height: 1.5;
}